<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_soft"
    android:elevation="6.0dip"
    android:padding="24.0dip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ss_navy"
        android:textSize="17.0sp"
        android:textStyle="bold" />
    <TextView
        android:id="@id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:lineSpacingExtra="3.0dip"
        android:textColor="@color/ss_text_secondary"
        android:textSize="14.0sp" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22.0dip">
        <Button
            android:id="@id/btnDialogCancel"
            android:layout_width="0.0dip"
            android:layout_height="46.0dip"
            android:layout_weight="1.0"
            android:background="@drawable/bg_dialog_cancel"
            android:text="取消"
            android:textAllCaps="false"
            android:textColor="@color/scrollshot_blue"
            android:textSize="15.0sp" />
        <Button
            android:id="@id/btnDialogOk"
            android:layout_width="0.0dip"
            android:layout_height="46.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="12.0dip"
            android:background="@drawable/bg_primary_button"
            android:textAllCaps="false"
            android:textColor="@color/ss_on_blue"
            android:textSize="15.0sp" />
    </LinearLayout>
</LinearLayout>
